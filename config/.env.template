# Quantum Anchor — environment template
#
# THIS FILE IS SAFE TO COMMIT. It contains PLACEHOLDERS ONLY.
# Copy it to config/.env and fill in real values there — config/.env is
# gitignored and must never be committed.
#
# ⚠️ NOTE ON CREDENTIALS: this project talks to real quantum hardware, and a
# leaked IBM token is a leaked billable resource tied to a real account.
# Tokens are read from the ENVIRONMENT ONLY. They are never written to a file.

# Required only if you run anything against IBM Quantum hardware.
# Obtain at: https://quantum.cloud.ibm.com → Account settings → API key
IBM_QUANTUM_API_TOKEN=your_api_key_here

# Optional: CRN of a specific instance.
IBM_QUANTUM_INSTANCE=your_crn_here

# Optional: channel name.
IBM_QUANTUM_CHANNEL=ibm_quantum_platform