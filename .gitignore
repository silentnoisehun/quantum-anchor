# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Local secret files. `.env.*` would swallow the template, so the
# template is explicitly re-included right after.
.env
.env.*
!.env.template
!config/.env.template

# Virtual environments
.venv/
venv/
env/

# Editors / OS noise
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp

# Measurement output
*.qasm

# Scratch file from a local dependency experiment (not part of the project).
_stdcheck.py

# CI scratch output
out.txt

# Captured CI logs. These are transcripts of a workflow run, not project
# artifacts — they reference action versions and runner internals that go
# stale immediately and make the repo look like it ships CI output.
runlog*.txt
*.log

# Editor / tooling scratch
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.bak
*.orig
