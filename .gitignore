# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Local secret files. `.env.*` would swallow the template, so the
# template is explicitly re-included right after.
.env
.env.*
!.env.template
!config/.env.template

# Virtual environments
.venv/
venv/
env/

# Editors / OS noise
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp

# Measurement output
*.qasm
